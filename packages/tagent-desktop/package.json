{
  "name": "@tagent/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:build dev:electron",
    "dev:build": "tsc -w",
    "dev:electron": "wait-on dist/main.js && electron .",
    "build": "tsc",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@tagent/server": "workspace:*",
    "@tagent/web": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.tagent.app",
    "productName": "TAgent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "../tagent-web/out/**/*",
      "../tagent-server/dist/**/*",
      "../tagent-ai/dist/**/*",
      "../tagent-core/dist/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  }
}
