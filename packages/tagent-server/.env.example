# TAgent Server — 环境变量模板
# 复制为 .env 并填入真实值: cp .env.example .env

# ── AI Provider (至少配置一个) ──
# DEEPSEEK_API_KEY=sk-your-deepseek-key
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# OPENAI_API_KEY=sk-your-openai-key

# 可选：显式选择 provider；未设置时按 DeepSeek / Anthropic / OpenAI 已配置密钥选择。
# TAGENT_LLM_PROVIDER=deepseek
# TAGENT_LLM_MODEL=deepseek-flash
# Optional same-provider model for office review and its at-most-one revision.
# Unset follows the task model with reasoning disabled; no automatic quality/cost upgrade.
# Supported values require a known price so the existing task budget can be checked.
# These settings do not change planning, tool loops, web research or Benchmark runs.
# TAGENT_OFFICE_REVIEW_MODEL=deepseek-v4-pro
# TAGENT_OFFICE_REVIEW_REASONING=low
# Optional model for the explicitly selected read-only Explore mode. Uses the same provider/account.
# Unset keeps TAGENT_LLM_MODEL; unknown pricing skips the summary and retains source material.
# TAGENT_EXPLORE_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_BASE_URL=https://api.openai.com/v1
# Whole model request deadline, including the response body/stream (1000-300000 ms).
# SDK automatic retries are disabled. Interrupted requests may still be billed upstream.
TAGENT_LLM_TIMEOUT_MS=60000
# Total task runtime before cooperative cancellation (1000-1800000 ms).
# Cleanup and final persistence complete after cancellation; this is not a process kill deadline.
TAGENT_RUN_TIMEOUT_MS=600000
# Single-process task admission. No queue or automatic retry; rejected input stays a draft.
# Active includes preparing, running, stopping and final persistence. Range: 1-16 tasks.
TAGENT_MAX_ACTIVE_RUNS=4
# Per-message UTF-8 byte limit (1024-524288); independent of the 2 MiB HTTP body limit.
TAGENT_MAX_TASK_INPUT_BYTES=65536

# ── 调研搜索（与模型服务、Skill/MCP 联网发现分别配置） ──
# 默认不设置：首次使用现有搜索源，用户可在管理中心确认后切换并保存。
# 管理员需要锁定来源时，才取消下面 auto 或 parallel 中一行的注释；页面不能覆盖。
# TAGENT_SEARCH_PROVIDER=auto
# 搜索关键词和目标会发送到第三方；不上传文件、不安装 MCP、不执行命令。
# 本适配器不使用 PARALLEL_API_KEY，不自动转为付费调用；免费服务有额度/可用性限制。
# TAGENT_SEARCH_PROVIDER=parallel
# 文档：docs/research-search.md。health 的 unchecked 不代表已验证连通。

# ── 数据库 (Docker: docker compose up -d) ──
# 默认使用项目 .tagent/data/workspaces.json；需要数据库时再取消注释。
# DATABASE_URL=postgres://tagent:tagent_dev@localhost:5432/tagent
# REDIS_URL=redis://localhost:6379

# ── 服务端口 ──
PORT=3001
TAGENT_HOST=127.0.0.1
# ── 单实例访问保护 ──
# 本地开发可不设置访问码；对外监听或 NODE_ENV=production 时必须设置以下两项。
# 请使用独立随机访问码（至少 32 字符），不能使用模型 API Key。
# TAGENT_ACCESS_TOKEN=replace-with-a-random-instance-access-secret
# TAGENT_PUBLIC_ORIGIN=https://office.example.com
# 多个前端来源用逗号分隔；默认仅允许本地 3000 端口，或上述 PUBLIC_ORIGIN。
# TAGENT_WEB_ORIGINS=https://office.example.com
# Rolling 60-second single-owner request limits (1-10000; no automatic retries).
# Read, write and external-work lanes are independent of stop/approval/logout requests.
# TAGENT_API_READ_PER_MINUTE=600
# TAGENT_API_WRITE_PER_MINUTE=120
# TAGENT_API_EXTERNAL_PER_MINUTE=30
# NODE_ENV=production
# 数据目录默认是项目根目录，可独立配置，不受启动位置影响。
# TAGENT_WORKSPACE_ROOT=./runtime
# 部署环境变量优先于 .env，空值也不会被 .env 覆盖。
# Optional trusted browser egress proxy. Windows otherwise uses the current user's system HTTP proxy.
# Set to "direct" to disable proxy inheritance. Targets are still pinned to validated public IPs.
# TAGENT_BROWSER_PROXY_URL=http://127.0.0.1:7890
